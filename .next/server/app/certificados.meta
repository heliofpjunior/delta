{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/certificados/layout,_N_T_/certificados/page,_N_T_/certificados"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/certificados/__PAGE__",
    "/certificados",
    "/_index",
    "/_head"
  ]
}